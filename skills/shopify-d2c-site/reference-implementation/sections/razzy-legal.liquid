{% comment %}
  Section contract.
  Text page for legal and info content (supplement disclaimer, accessibility, FAQ, and similar).
  Shows the page title and the page's rich text content in the same readable layout Shopify's
  built-in policy pages use; the shared prose styles live in base.css under .rz-legal.
  @example
  <!-- Assign the "page.legal" template to a page in Online Store → Pages -->
{% endcomment %}

<section
  class="rz-legal-section"
  style="--rz-legal-bg: {{ section.settings.background }}; --rz-legal-fg: {{ section.settings.text_color }}; --rz-legal-accent: {{ section.settings.accent }};"
>
  <div class="rz-legal">
    <h1 class="rz-legal__title">{{ page.title | escape }}</h1>
    <div class="rz-legal__body rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Razzy legal page",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAFAF5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#05060B"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Link and rule colour",
      "default": "#054FB8"
    }
  ],
  "presets": [
    {
      "name": "Razzy legal page"
    }
  ]
}
{% endschema %}
