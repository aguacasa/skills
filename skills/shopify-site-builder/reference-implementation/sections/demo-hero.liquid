{% comment %}
  Section contract.
  Full-screen Demo hero: a WebGL ring of product tins orbits a giant headline. Tins pass in
  front of and behind the type; drag spins the ring, hovering slows it, clicking a tin opens
  that product. Plays a wordmark intro once per visit. Falls back to product cutouts without
  WebGL or with reduced motion.
  @example
  <!-- Homepage first section. Pick up to seven products; each needs demo.color and demo.cutout metafields. -->
{% endcomment %}
{%- liquid
  assign rz_products = section.settings.products
  if rz_products == blank
    assign rz_products = collections.all.products
  endif
-%}

<section
  class="rz-hero"
  data-rz-hero
  style="--rz-hero-bg: {{ section.settings.background }}; --rz-hero-fg: {{ section.settings.text_color }};"
>
  {%- if section.settings.show_intro -%}
    <div class="rz-intro" data-rz-intro aria-hidden="true">
      {{ 'demo-wordmark.svg' | inline_asset_content }}
    </div>
  {%- endif -%}

  <div class="rz-hero__stage" data-rz-hero-stage aria-hidden="true">
    <div class="rz-hero__layer rz-hero__layer--back" data-rz-layer="back"></div>
    <div class="rz-hero__fallback">
      {%- for product in rz_products limit: 3 -%}
        {%- assign rz_cutout = product.metafields.demo.cutout.value -%}
        {%- if rz_cutout -%}
          {{
            rz_cutout
            | image_url: width: 900
            | image_tag:
              class: 'rz-hero__fallback-tin',
              widths: '300, 500, 700, 900',
              sizes: '(min-width: 900px) 24vw, 46vw',
              loading: 'eager',
              alt: ''
          }}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="rz-hero__layer rz-hero__layer--front" data-rz-layer="front"></div>
  </div>

  <div class="rz-hero__inner" data-rz-hero-inner>
    <h1 class="rz-hero__title" data-rz-hero-title>{{ section.settings.heading }}</h1>
    <div class="rz-hero__ctas" data-rz-hero-fade>
      {%- if section.settings.primary_label != blank -%}
        <a class="rz-btn rz-btn--xl" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" data-rz-magnetic>
          {{ section.settings.primary_label | escape }}
          <svg class="rz-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="rz-btn rz-btn--xl rz-btn--ghost" href="{{ section.settings.secondary_link }}" data-rz-magnetic>
          {{ section.settings.secondary_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {% render 'demo-drip', color: section.settings.background %}

  {%- comment -%}
    Label textures are cropped from each product's featured image, a Supliful 2048px mockup
    with the tin lid label at x 392–1656, y 512–1764.
  {%- endcomment -%}
  <script type="application/json" data-rz-hero-data>
    {
      "products": [
        {%- for product in rz_products limit: 7 -%}
          {%- capture rz_color -%}{{ product.metafields.demo.color.value | default: '#054FB8' }}{%- endcapture -%}
          {%- capture rz_label -%}
            {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 768 }}&crop=region&crop_left=392&crop_top=512&crop_width=1264&crop_height=1252{%- endif -%}
          {%- endcapture -%}
          {
            "title": {{ product.title | json }},
            "short": {{ product.title | remove: ' Strips' | json }},
            "url": {{ product.url | json }},
            "color": {{ rz_color | json }},
            "label": {{ rz_label | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% stylesheet %}
  /* No isolation here: the fixed intro inside this section must stack above the header. */
  .rz-hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    padding: calc(var(--header-height, 72px) + 28px) var(--rz-gutter) 92px;
    overflow: clip;
    background: var(--rz-hero-bg);
    color: var(--rz-hero-fg);
  }

  .rz-hero .rz-drip {
    z-index: 5;
  }

  .rz-hero__stage {
    position: absolute;
    inset: 0;
  }

  .rz-hero__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s var(--rz-ease);
  }

  .rz-hero__layer canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .rz-hero__layer--front {
    z-index: 3;
    pointer-events: none;
  }

  .rz-hero.is-3d-ready .rz-hero__layer {
    opacity: 1;
  }

  .rz-hero__fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s var(--rz-ease);
  }

  /* Cutouts are the no-WebGL fallback. While the ring is pending they stay hidden, so they never
     ghost behind the headline before the 3D ring fades in. Without rz-motion (no JS, or script
     failed) or with the fallback class, they show. */
  html.rz-motion .rz-hero:not(.is-fallback) .rz-hero__fallback {
    opacity: 0;
  }

  .rz-hero.is-fallback .rz-hero__fallback {
    opacity: 1;
  }

  .rz-hero__fallback-tin {
    width: min(22vw, 340px);
    height: auto;
    filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.35));
    opacity: 0.5;
  }

  .rz-hero__fallback-tin:nth-child(1) {
    transform: translate(18%, 20%) rotate(-14deg);
  }

  .rz-hero__fallback-tin:nth-child(2) {
    z-index: 1;
    transform: translateY(-22%) scale(1.1);
  }

  .rz-hero__fallback-tin:nth-child(3) {
    transform: translate(-18%, 24%) rotate(12deg);
  }

  .rz-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(28px, 3.4vw, 48px);
    text-align: center;
    pointer-events: none;
  }

  .rz-hero__title {
    max-width: 14ch;
    margin: 0;
    font-family: var(--rz-display);
    font-weight: 900;
    font-size: clamp(58px, 10.6vw, 200px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--rz-hero-fg);
  }

  .rz-hero__title em {
    font-style: italic;
    font-weight: 800;
    color: #fff;
  }

  html.rz-motion .rz-hero__title:not(.is-split) {
    visibility: hidden;
  }

  .rz-hero__ctas {
    --rz-ghost-hover: var(--rz-hero-bg);
    position: relative;
    z-index: 4;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    pointer-events: auto;
  }

  /* The hover fill uses --rz-btn-fg, so set it explicitly: the hover text colour is the
     hero background, and it must sit on the lime fill rather than the same colour. */
  .rz-hero__ctas .rz-btn--ghost {
    --rz-btn-fg: var(--rz-hero-fg);
    color: var(--rz-hero-fg);
    background: color-mix(in srgb, var(--rz-hero-bg) 55%, transparent);
    backdrop-filter: blur(8px);
  }

  .rz-hero__ctas .rz-btn--ghost:hover,
  .rz-hero__ctas .rz-btn--ghost:focus-visible {
    color: var(--rz-hero-bg);
  }

  /* Wordmark intro (first visit per session) */
  .rz-intro {
    position: fixed;
    inset: 0;
    z-index: 2147482500;
    display: grid;
    place-items: center;
    background: var(--rz-hero-bg);
    color: var(--rz-hero-fg);
    clip-path: inset(0% 0% 0% 0%);
    animation: rz-intro-failsafe 0.6s ease 3.4s forwards;
  }

  .rz-intro .rz-wordmark {
    width: min(78vw, 980px);
    height: auto;
    overflow: hidden;
  }

  html.rz-intro-seen .rz-intro {
    display: none;
  }

  @keyframes rz-intro-failsafe {
    to {
      clip-path: inset(0% 0% 100% 0%);
      visibility: hidden;
    }
  }

  @media (max-width: 899px) {
    .rz-hero {
      padding-bottom: 84px;
    }


  }

  @media (prefers-reduced-motion: reduce) {
    .rz-intro {
      display: none;
    }

    .rz-hero__fallback-tin {
      opacity: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Play wordmark intro",
      "info": "Plays once per visit.",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic words are set in white.",
      "default": "Wellness that <em>melts</em> on your tongue."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop all seven"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Primary button link",
      "info": "A URL or an anchor such as #lineup",
      "default": "#lineup"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Secondary button link",
      "default": "#how-it-works"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products in the 3D ring",
      "limit": 7
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#054FB8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#CEFF65"
    }
  ],
  "presets": [
    {
      "name": "Demo hero"
    }
  ]
}
{% endschema %}
