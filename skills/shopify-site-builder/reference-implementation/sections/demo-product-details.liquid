{% comment %}
  Section contract.
  Product-details accordion driven by merchant-reviewed custom metafields.
  Category-specific rows appear only when populated. Question blocks add FAQ rows;
  any disclaimer must be explicitly supplied and relevant to this store.
  @example
  <!-- On the product template it uses the page's product; add Question blocks for FAQs -->
{% endcomment %}
{%- assign rz_product = section.settings.product | default: product -%}
{%- capture rz_about -%}{% render 'demo-description', product: rz_product, part: 'about' %}{%- endcapture -%}
{%- capture rz_use -%}{% render 'demo-description', product: rz_product, part: 'suggested_use' %}{%- endcapture -%}
{%- capture rz_ingredients -%}{% render 'demo-description', product: rz_product, part: 'ingredients' %}{%- endcapture -%}
{%- capture rz_flavor -%}{% render 'demo-description', product: rz_product, part: 'flavor' %}{%- endcapture -%}
{%- capture rz_amount -%}{% render 'demo-description', product: rz_product, part: 'amount' %}{%- endcapture -%}
{%- capture rz_weight -%}{% render 'demo-description', product: rz_product, part: 'weight' %}{%- endcapture -%}
{%- capture rz_country -%}{% render 'demo-description', product: rz_product, part: 'country' %}{%- endcapture -%}
{%- capture rz_warning -%}{% render 'demo-description', product: rz_product, part: 'warning' %}{%- endcapture -%}
{%- capture rz_caution -%}{% render 'demo-description', product: rz_product, part: 'caution' %}{%- endcapture -%}
{%- assign rz_facts_image = rz_product.metafields.custom.details_image.value -%}

{%- capture rz_plus -%}
  <span class="rz-acc__icon" aria-hidden="true"></span>
{%- endcapture -%}

<section
  class="rz-details"
  data-rz-accordion
  style="{% render 'demo-vars', product: rz_product %} --rz-details-bg: {{ section.settings.background }}; --rz-details-fg: {{ section.settings.text_color }};"
>
  <div class="rz-details__head">
    <h2 class="rz-h2" data-rz-split>{{ section.settings.heading }}</h2>
  </div>

  <div class="rz-details__list">
    {%- if rz_about != blank -%}
      <details class="rz-acc">
        <summary><span>{{ section.settings.about_label | escape }}</span>{{ rz_plus }}</summary>
        <div class="rz-acc__content"><div class="rz-acc__inner rz-acc__rte">{{ rz_about }}</div></div>
      </details>
    {%- endif -%}

    {%- if rz_use != blank -%}
      <details class="rz-acc">
        <summary><span>{{ section.settings.use_label | escape }}</span>{{ rz_plus }}</summary>
        <div class="rz-acc__content"><div class="rz-acc__inner"><p>{{ rz_use }}</p></div></div>
      </details>
    {%- endif -%}

    {%- if rz_ingredients != blank or rz_facts_image -%}
      <details class="rz-acc">
        <summary><span>{{ section.settings.ingredients_label | escape }}</span>{{ rz_plus }}</summary>
        <div class="rz-acc__content">
          <div class="rz-acc__inner">
            {%- if rz_ingredients != blank -%}<p>{{ rz_ingredients }}</p>{%- endif -%}
            {%- if rz_facts_image -%}
              {{
                rz_facts_image
                | image_url: width: 980
                | image_tag: class: 'rz-acc__facts', loading: 'lazy', alt: section.settings.facts_alt
              }}
            {%- endif -%}
          </div>
        </div>
      </details>
    {%- endif -%}

    {%- if rz_flavor != blank or rz_amount != blank or rz_weight != blank or rz_country != blank -%}
      <details class="rz-acc">
        <summary><span>{{ section.settings.size_label | escape }}</span>{{ rz_plus }}</summary>
        <div class="rz-acc__content">
          <div class="rz-acc__inner">
            <dl class="rz-acc__facts-list">
              {%- if rz_flavor != blank -%}<div><dt>Flavor</dt><dd>{{ rz_flavor }}</dd></div>{%- endif -%}
              {%- if rz_amount != blank -%}<div><dt>Quantity</dt><dd>{{ rz_amount }}</dd></div>{%- endif -%}
              {%- if rz_weight != blank -%}<div><dt>Gross weight</dt><dd>{{ rz_weight }}</dd></div>{%- endif -%}
              {%- if rz_country != blank -%}<div><dt>Made in</dt><dd>{{ rz_country }}</dd></div>{%- endif -%}
            </dl>
          </div>
        </div>
      </details>
    {%- endif -%}

    {%- if rz_warning != blank or rz_caution != blank -%}
      <details class="rz-acc">
        <summary><span>{{ section.settings.warnings_label | escape }}</span>{{ rz_plus }}</summary>
        <div class="rz-acc__content">
          <div class="rz-acc__inner">
            {%- if rz_warning != blank -%}<p>{{ rz_warning }}</p>{%- endif -%}
            {%- if rz_caution != blank -%}<p>{{ rz_caution }}</p>{%- endif -%}
          </div>
        </div>
      </details>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <details class="rz-acc" {{ block.shopify_attributes }}>
        <summary><span>{{ block.settings.question | escape }}</span>{{ rz_plus }}</summary>
        <div class="rz-acc__content"><div class="rz-acc__inner rz-acc__rte">{{ block.settings.answer }}</div></div>
      </details>
    {%- endfor -%}
  </div>

  {%- if section.settings.disclaimer != blank -%}
    <p class="rz-details__disclaimer">{{ section.settings.disclaimer | escape }}</p>
  {%- endif -%}
</section>

{% stylesheet %}
  .rz-details {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 90px);
    padding: clamp(90px, 10vw, 150px) var(--rz-gutter);
    background: var(--rz-details-bg);
    color: var(--rz-details-fg);
  }

  .rz-details__head .rz-h2 {
    position: sticky;
    top: calc(var(--header-height, 72px) + 32px);
  }

  .rz-details__list {
    border-top: 2px solid currentColor;
  }

  .rz-acc {
    border-bottom: 2px solid currentColor;
  }

  .rz-acc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(18px, 2vw, 26px) 0;
    font-family: var(--rz-display);
    font-weight: 900;
    font-size: clamp(24px, 2.4vw, 38px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    list-style: none;
    cursor: pointer;
  }

  .rz-acc summary::-webkit-details-marker {
    display: none;
  }

  .rz-acc summary:hover span:first-child {
    color: var(--rz-c);
  }

  .rz-acc__icon {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--rz-c);
    transition: transform 0.5s var(--rz-spring);
  }

  .rz-acc__icon::before,
  .rz-acc__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--rz-fg);
    transform: translate(-50%, -50%);
    transition: transform 0.5s var(--rz-spring);
  }

  .rz-acc__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .rz-acc[open] .rz-acc__icon {
    transform: rotate(180deg);
  }

  .rz-acc[open] .rz-acc__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .rz-acc__content {
    overflow: hidden;
  }

  .rz-acc__inner {
    display: grid;
    gap: 14px;
    max-width: 70ch;
    padding-bottom: 28px;
    font-size: clamp(16px, 1.15vw, 18px);
    line-height: 1.6;
  }

  .rz-acc__inner p {
    margin: 0;
  }

  .rz-acc__facts {
    width: min(100%, 520px);
    height: auto;
    border-radius: 16px;
    background: #fff;
  }

  .rz-acc__facts-list {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .rz-acc__facts-list div {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 12px;
  }

  .rz-acc__facts-list dt {
    font-weight: 800;
  }

  .rz-acc__facts-list dd {
    margin: 0;
  }

  .rz-details__disclaimer {
    grid-column: 2;
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.7;
  }

  @media (max-width: 899px) {
    .rz-details {
      grid-template-columns: 1fr;
    }

    .rz-details__head .rz-h2 {
      position: static;
    }

    .rz-details__disclaimer {
      grid-column: 1;
    }

    .rz-acc__facts-list div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo product details",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty on product pages to use the page's product."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The <em>fine print.</em>"
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "About row",
      "default": "About this product"
    },
    {
      "type": "text",
      "id": "use_label",
      "label": "How to use row",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "ingredients_label",
      "label": "Ingredients row",
      "default": "Materials or ingredients"
    },
    {
      "type": "text",
      "id": "facts_alt",
      "label": "Product details image alt text",
      "default": "Product details"
    },
    {
      "type": "text",
      "id": "size_label",
      "label": "Product specifications row",
      "default": "Product specifications"
    },
    {
      "type": "text",
      "id": "warnings_label",
      "label": "Warnings row",
      "default": "Warnings"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "info": "Optional. Supply only reviewed wording relevant to this product and sales region."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAFAF5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#05060B"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What should I know before ordering?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add the reviewed answer for this product.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Demo product details",
      "blocks": [
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
