{% comment %}
  Section contract.
  Two crossing marquee "tapes" that overlap the sections above and below. They speed up,
  reverse and skew with scroll velocity.
  @example
  <!-- Place between two full-bleed sections; items are separated with | -->
{% endcomment %}
{%- liquid
  assign rz_a = section.settings.text_a | split: '|'
  assign rz_b = section.settings.text_b | split: '|'
-%}

<div class="rz-tape" data-rz-tape aria-hidden="true">
  {%- for band in (1..2) -%}
    {%- if band == 1 -%}
      {%- assign rz_items = rz_a -%}
      {%- assign rz_style = '--rz-tape-bg:' | append: section.settings.color_a | append: ';--rz-tape-fg:' | append: section.settings.text_color_a -%}
    {%- else -%}
      {%- assign rz_items = rz_b -%}
      {%- assign rz_style = '--rz-tape-bg:' | append: section.settings.color_b | append: ';--rz-tape-fg:' | append: section.settings.text_color_b -%}
    {%- endif -%}
    <div class="rz-tape__band rz-tape__band--{{ band }}" style="{{ rz_style }}">
      <div class="rz-tape__skew" data-rz-tape-band>
        <div class="rz-tape__track" data-rz-tape-track data-speed="{% if band == 1 %}30{% else %}24{% endif %}">
          {%- for copy in (1..2) -%}
            <div class="rz-tape__group">
              {%- for item in rz_items -%}
                <span class="rz-tape__item">{{ item | strip | escape }}</span>
                <svg class="rz-tape__star" viewBox="0 0 40 40" aria-hidden="true"><path fill="currentColor" d="M20 0l4.6 13.2L38 9.4l-9.8 10.6L38 30.6l-13.4-3.8L20 40l-4.6-13.2L2 30.6l9.8-10.6L2 9.4l13.4 3.8z"/></svg>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  /* Two flat ribbons stacked between the hero and the next section. Sits under the
     hero's drips so they hang over the top ribbon. */
  .rz-tape {
    position: relative;
    z-index: 4;
    overflow: clip;
    pointer-events: none;
  }

  .rz-tape__band {
    background: var(--rz-tape-bg);
    color: var(--rz-tape-fg);
  }

  .rz-tape__skew {
    padding-block: clamp(6px, 0.7vw, 11px);
  }

  .rz-tape__track,
  .rz-tape__group {
    display: flex;
    align-items: center;
    width: max-content;
  }

  .rz-tape__item {
    padding-inline: clamp(16px, 2vw, 32px);
    font-family: var(--rz-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(22px, 2.9vw, 46px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rz-tape__star {
    width: clamp(16px, 1.8vw, 28px);
    height: auto;
    flex: none;
    animation: rz-spin 6s linear infinite;
  }

  @keyframes rz-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rz-tape__star {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo tape",
  "settings": [
    {
      "type": "text",
      "id": "text_a",
      "label": "Top tape",
      "info": "Separate items with |",
      "default": "No water | No pills | Just strips | One a day"
    },
    {
      "type": "color",
      "id": "color_a",
      "label": "Top tape color",
      "default": "#CEFF65"
    },
    {
      "type": "color",
      "id": "text_color_a",
      "label": "Top tape text",
      "default": "#054FB8"
    },
    {
      "type": "text",
      "id": "text_b",
      "label": "Bottom tape",
      "info": "Separate items with |",
      "default": "Peel | Place | Dissolve | Repeat tomorrow"
    },
    {
      "type": "color",
      "id": "color_b",
      "label": "Bottom tape color",
      "default": "#FF7654"
    },
    {
      "type": "color",
      "id": "text_color_b",
      "label": "Bottom tape text",
      "default": "#05060B"
    }
  ],
  "presets": [
    {
      "name": "Demo tape"
    }
  ]
}
{% endschema %}
