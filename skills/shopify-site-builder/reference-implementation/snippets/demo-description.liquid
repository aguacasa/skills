{% doc %}
  Renders merchant-reviewed product content from typed custom metafields.
  No supplier HTML structure, image alt text, or product category is inferred.
  About falls back to the complete product description when no about field exists.
  Other missing fields output nothing. Plain text is escaped; rich about uses metafield_tag.

  @param {product} product - Product to read
  @param {string} part - Metafield key, such as summary, about, or care_instructions
  @param {string} [namespace] - Merchant-owned namespace; defaults to custom
{% enddoc %}
{%- liquid
  assign rz_namespace = namespace | default: 'custom'
  assign rz_field = product.metafields[rz_namespace][part]

  if part == 'about'
    if rz_field.value != blank
      if rz_field.type == 'rich_text_field'
        echo rz_field | metafield_tag
      elsif rz_field.type == 'single_line_text_field' or rz_field.type == 'multi_line_text_field'
        echo rz_field.value | escape | newline_to_br
      endif
    else
      echo product.description
    endif
  elsif rz_field.value != blank
    if rz_field.type == 'list.single_line_text_field'
      echo rz_field.value | join: ', ' | escape
    elsif rz_field.type == 'single_line_text_field' or rz_field.type == 'multi_line_text_field'
      echo rz_field.value | escape | newline_to_br
    endif
  endif
-%}
