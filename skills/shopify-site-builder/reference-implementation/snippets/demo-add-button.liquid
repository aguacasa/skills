{%- doc -%}
  One-tap add-to-cart pill for a product's first available variant, handled by demo.js.
  Shows the price, and falls back to a link to the product when nothing is available.

  @param {product} product - Product to add
  @param {string} [class] - Extra classes for the button

  @example
  {% render 'demo-add-button', product: product, class: 'rz-btn--ink' %}
{%- enddoc -%}
{%- liquid
  assign rz_variant = product.selected_or_first_available_variant
  assign rz_price = rz_variant.price | default: product.price | money_without_trailing_zeros
-%}
{%- if product.available and rz_variant.available -%}
  <button
    type="button"
    class="rz-btn rz-add {{ class }}"
    data-rz-add
    data-variant-id="{{ rz_variant.id }}"
    aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}, {{ rz_price }}"
  >
    <span data-label="idle">{{ 'products.product.add_to_cart' | t }} · {{ rz_price }}</span>
    <span data-label="loading">{{ 'products.product.adding_to_cart' | t }}</span>
    <span data-label="added">{{ 'products.product.added_to_cart' | t }}</span>
    <span data-label="error">{{ 'products.product.add_to_cart_error' | t }}</span>
  </button>
{%- else -%}
  <a class="rz-btn {{ class }}" href="{{ product.url }}">{{ 'products.product.sold_out' | t }}</a>
{%- endif -%}
