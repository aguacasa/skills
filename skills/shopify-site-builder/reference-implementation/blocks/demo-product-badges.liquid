{% doc %}
  Renders merchant-verified product badges from custom.badges, a list of plain text.
  Missing data outputs no badges; images or description prose never imply certification.
{% enddoc %}
{%- assign rz_badges = closest.product.metafields.custom.badges.value -%}

{%- if rz_badges != blank -%}
  <ul class="rz-pdp-badges" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
    {%- for badge in rz_badges -%}
      {%- if badge != blank -%}
        <li class="rz-pdp-badges__item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5l4.5 4.5L19.5 7" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ badge | escape }}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .rz-pdp-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--rz-sans);
    font-weight: 700;
    font-size: 14px;
  }

  .rz-pdp-badges__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .rz-pdp-badges__item svg {
    width: 18px;
    height: 18px;
    padding: 2px;
    border-radius: 50%;
    background: var(--rz-accent, var(--rz-lime));
    color: var(--rz-accent-fg, var(--rz-ink));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo product badges",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "List label (screen readers)",
      "default": "Product attributes"
    }
  ],
  "presets": [
    {
      "name": "Demo product badges"
    }
  ]
}
{% endschema %}
