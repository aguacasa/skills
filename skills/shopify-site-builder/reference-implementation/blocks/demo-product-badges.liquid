{% doc %}
  Dietary badges (Gluten-free, Vegan friendly…) read from the badge images at the end of the
  Supliful product description, shown as check chips.
{% enddoc %}
{%- capture rz_badges -%}{% render 'demo-description', product: closest.product, part: 'badges' %}{%- endcapture -%}
{%- assign rz_badges = rz_badges | strip | split: '|' -%}

{%- if rz_badges.size > 0 -%}
  <ul class="rz-pdp-badges" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
    {%- for badge in rz_badges -%}
      <li class="rz-pdp-badges__item">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5l4.5 4.5L19.5 7" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ badge | escape }}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .rz-pdp-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--rz-sans);
    font-weight: 700;
    font-size: 14px;
  }

  .rz-pdp-badges__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .rz-pdp-badges__item svg {
    width: 18px;
    height: 18px;
    padding: 2px;
    border-radius: 50%;
    background: var(--rz-accent, var(--rz-lime));
    color: var(--rz-accent-fg, var(--rz-ink));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo dietary badges",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "List label (screen readers)",
      "default": "Dietary information"
    }
  ],
  "presets": [
    {
      "name": "Demo dietary badges"
    }
  ]
}
{% endschema %}
