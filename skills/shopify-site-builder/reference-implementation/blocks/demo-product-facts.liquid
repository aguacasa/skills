{% doc %}
  Quick facts tiles (strips per tin, daily dose, no water, flavour from custom.flavor) and the
  key ingredients from the custom.ingredients metafield as chips. The fact tiles are block
  settings, so a template can override them (the bundle template shows tins and strips).
{% enddoc %}
{%- liquid
  assign rz_product = closest.product
  assign rz_flavor = rz_product.metafields.custom.flavor.value
  assign rz_ingredients = rz_product.metafields.custom.ingredients.value

  # One column per tile, so three tiles (a bundle has no single flavour) fill the row.
  assign rz_tile_count = 0
  for i in (1..3)
    assign value_key = 'fact_' | append: i | append: '_value'
    if block.settings[value_key] != blank
      assign rz_tile_count = rz_tile_count | plus: 1
    endif
  endfor
  if rz_flavor != blank
    assign rz_tile_count = rz_tile_count | plus: 1
  endif
-%}

<div class="rz-pdp-facts" {{ block.shopify_attributes }}>
  {%- if rz_tile_count > 0 -%}
    <ul class="rz-pdp-facts__tiles{% if rz_tile_count > 3 %} rz-pdp-facts__tiles--pairs{% endif %}" style="--rz-facts-cols: {{ rz_tile_count }};">
      {%- for i in (1..3) -%}
        {%- capture value_key -%}fact_{{ i }}_value{%- endcapture -%}
        {%- capture label_key -%}fact_{{ i }}_label{%- endcapture -%}
        {%- if block.settings[value_key] != blank -%}
          <li class="rz-pdp-facts__tile">
            <span class="rz-pdp-facts__value">{{ block.settings[value_key] | escape }}</span>
            <span class="rz-pdp-facts__label">{{ block.settings[label_key] | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- if rz_flavor != blank -%}
        <li class="rz-pdp-facts__tile rz-pdp-facts__tile--flavor">
          <span class="rz-pdp-facts__value">{{ rz_flavor | escape }}</span>
          <span class="rz-pdp-facts__label">{{ block.settings.flavor_label | escape }}</span>
        </li>
      {%- endif -%}
    </ul>
  {%- endif -%}

  {%- if rz_ingredients != blank -%}
    <ul class="rz-chips" aria-label="{{ block.settings.ingredients_label | escape }}">
      {%- for ingredient in rz_ingredients -%}
        <li class="rz-chip">{{ ingredient | escape }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .rz-pdp-facts {
    display: grid;
    gap: 16px;
  }

  .rz-pdp-facts__tiles {
    display: grid;
    grid-template-columns: repeat(var(--rz-facts-cols, 4), minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rz-pdp-facts__tile {
    display: grid;
    align-content: center;
    gap: 4px;
    min-height: 84px;
    padding: 12px 14px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--rz-fg, #fff) 12%, transparent);
  }

  .rz-pdp-facts__value {
    font-family: var(--rz-display);
    font-weight: 900;
    font-size: clamp(24px, 2vw, 32px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--rz-accent, currentColor);
  }

  .rz-pdp-facts__tile--flavor .rz-pdp-facts__value {
    font-size: clamp(16px, 1.2vw, 19px);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .rz-pdp-facts__label {
    font-family: var(--rz-sans);
    font-weight: 700;
    font-size: 12px;
    line-height: 1.2;
    opacity: 0.85;
  }

  @media (max-width: 599px) {
    .rz-pdp-facts__tiles--pairs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Demo product facts",
  "settings": [
    {
      "type": "text",
      "id": "fact_1_value",
      "label": "Fact 1",
      "default": "30"
    },
    {
      "type": "text",
      "id": "fact_1_label",
      "label": "Fact 1 label",
      "default": "strips per tin"
    },
    {
      "type": "text",
      "id": "fact_2_value",
      "label": "Fact 2",
      "default": "1 a day"
    },
    {
      "type": "text",
      "id": "fact_2_label",
      "label": "Fact 2 label",
      "default": "that's the routine"
    },
    {
      "type": "text",
      "id": "fact_3_value",
      "label": "Fact 3",
      "default": "0"
    },
    {
      "type": "text",
      "id": "fact_3_label",
      "label": "Fact 3 label",
      "default": "water needed"
    },
    {
      "type": "text",
      "id": "flavor_label",
      "label": "Flavor label",
      "default": "flavor"
    },
    {
      "type": "text",
      "id": "ingredients_label",
      "label": "Ingredients label (screen readers)",
      "default": "Key ingredients"
    }
  ],
  "presets": [
    {
      "name": "Demo product facts"
    }
  ]
}
{% endschema %}
