{% comment %}
  Section contract.
  Pinned three-step story (peel, place, dissolve). Scrolling drives a WebGL strip that slides
  out of its sachet, curls and dissolves into particles, while a photo blooms behind it.
  Shows the steps and photo statically with reduced motion or without WebGL.
  @example
  <!-- Anchor id is "how-it-works" so buttons can link to #how-it-works -->
{% endcomment %}

{%- capture rz_how_style -%}
  {%- if section.settings.use_product_color and product -%}
    {% render 'razzy-vars', product: product %} --rz-how-bg: var(--rz-c); --rz-how-fg: var(--rz-fg); --rz-how-edge: var(--rz-accent);
  {%- else -%}
    --rz-how-bg: {{ section.settings.background }}; --rz-how-fg: {{ section.settings.text_color }}; --rz-how-edge: {{ section.settings.accent }};
  {%- endif -%}
{%- endcapture -%}

<section id="how-it-works" class="rz-how" data-rz-how style="{{ rz_how_style | strip }}">
  <div class="rz-how__copy">
    <h2 class="rz-how__heading rz-h2">{{ section.settings.heading }}</h2>
    <ol class="rz-how__steps">
      {%- for i in (1..3) -%}
        {%- capture title_key -%}step_{{ i }}_title{%- endcapture -%}
        {%- capture text_key -%}step_{{ i }}_text{%- endcapture -%}
        <li class="rz-how__step" data-rz-step>
          <span class="rz-how__num" aria-hidden="true">0{{ i }}</span>
          <div>
            <h3 class="rz-how__title">{{ section.settings[title_key] | escape }}</h3>
            <p class="rz-how__text">{{ section.settings[text_key] | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>

  <div class="rz-how__visual" aria-hidden="true">
    <div class="rz-how__photo">
      {%- if section.settings.image -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 900px) 45vw, 90vw', loading: 'lazy', alt: ''
        }}
      {%- endif -%}
    </div>
    <div class="rz-how__ring"></div>
    <div class="rz-how__stage" data-rz-how-stage></div>
    <p class="rz-how__badge"><span>{{ section.settings.badge | escape }}</span></p>
  </div>
</section>

{% stylesheet %}
  .rz-how {
    --rz-how-p: 0;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(24px, 4vw, 72px);
    min-height: 100svh;
    padding: calc(var(--header-height, 72px) + 24px) var(--rz-gutter) 48px;
    overflow: clip;
    background: var(--rz-how-bg);
    color: var(--rz-how-fg);
  }

  .rz-how__copy {
    display: grid;
    gap: clamp(18px, 2.4vw, 32px);
    align-content: center;
  }

  .rz-how__heading {
    font-size: clamp(42px, 5.6vw, 96px);
    color: var(--rz-how-edge);
  }

  .rz-how__steps {
    display: grid;
    gap: clamp(10px, 1.6vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rz-how__step {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 18px;
    opacity: 0.32;
    transform: translateX(-10px);
    transition:
      opacity 0.6s var(--rz-ease),
      transform 0.6s var(--rz-ease);
  }

  .rz-how__step.is-done {
    opacity: 0.55;
  }

  .rz-how__step.is-active,
  .rz-how.is-static .rz-how__step {
    opacity: 1;
    transform: none;
  }

  .rz-how__num {
    font-family: var(--rz-display);
    font-weight: 900;
    font-size: clamp(44px, 4.6vw, 76px);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--rz-how-edge);
  }

  .rz-how__step.is-active .rz-how__num {
    color: var(--rz-how-edge);
  }

  .rz-how__title {
    margin: 0 0 6px;
    font-family: var(--rz-display);
    font-weight: 900;
    font-size: clamp(30px, 3vw, 52px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: inherit;
  }

  .rz-how__text {
    max-width: 36ch;
    margin: 0;
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.5;
    opacity: 0.9;
  }

  .rz-how__visual {
    position: relative;
    justify-self: center;
    width: min(100%, 76svh, 780px);
    aspect-ratio: 1;
  }

  .rz-how__photo,
  .rz-how__ring {
    position: absolute;
    inset: 9%;
    border-radius: 50%;
  }

  .rz-how__photo {
    overflow: hidden;
    clip-path: circle(calc(clamp(0, (var(--rz-how-p) - 0.24) * 5, 1) * 50%) at 50% 50%);
    opacity: calc(1 - clamp(0, (var(--rz-how-p) - 0.82) * 5, 0.75));
  }

  .rz-how__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1.25 - clamp(0, (var(--rz-how-p) - 0.24) * 2, 0.25)));
  }

  .rz-how__ring {
    border: 1.5px dashed color-mix(in srgb, var(--rz-how-edge) 55%, transparent);
    animation: rz-spin 40s linear infinite;
  }

  .rz-how__stage {
    position: absolute;
    inset: -12%;
  }

  .rz-how__stage canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .rz-how__badge {
    position: absolute;
    right: 2%;
    top: 4%;
    display: grid;
    place-items: center;
    width: clamp(92px, 9vw, 136px);
    aspect-ratio: 1;
    margin: 0;
    border-radius: 50%;
    background: var(--rz-how-edge);
    color: var(--rz-how-bg);
    font-family: var(--rz-sans);
    font-weight: 800;
    font-size: clamp(12px, 1vw, 15px);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-12deg);
  }

  .rz-how__badge span {
    padding: 14px;
  }

  .rz-how.is-static .rz-how__photo {
    clip-path: none;
    opacity: 1;
  }

  @media (max-width: 899px) {
    .rz-how {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 8px;
      padding-top: calc(var(--header-height, 64px) + 12px);
    }

    .rz-how__heading {
      font-size: clamp(36px, 10vw, 56px);
    }

    .rz-how__steps {
      gap: 6px;
    }

    .rz-how__step {
      gap: 12px;
    }

    .rz-how__title {
      font-size: 26px;
    }

    .rz-how:not(.is-static) .rz-how__step:not(.is-active) .rz-how__text {
      display: none;
    }

    .rz-how__visual {
      width: min(86vw, 46svh);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Razzy how it works",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Peel. Place. <em>Gone.</em>"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "Peel"
    },
    {
      "type": "text",
      "id": "step_1_text",
      "label": "Step 1 text",
      "default": "Pop the tin, tear a sachet. Every strip is sealed on its own, so it is fresh whenever you are."
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 title",
      "default": "Place"
    },
    {
      "type": "text",
      "id": "step_2_text",
      "label": "Step 2 text",
      "default": "Lay the strip on your tongue. No water, no swallowing, no chalky pills."
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Step 3 title",
      "default": "Dissolve"
    },
    {
      "type": "text",
      "id": "step_3_text",
      "label": "Step 3 text",
      "default": "It melts away on its own. That is it. One strip a day, wherever your day takes you."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Revealed in a circle behind the strip during step 2."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "No water needed"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#470079"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FAFAF5"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#CEFF65"
    },
    {
      "type": "checkbox",
      "id": "use_product_color",
      "label": "Use the product's colour",
      "info": "On product pages, colours the section with the product's razzy.color instead of the colours below.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Razzy how it works"
    }
  ]
}
{% endschema %}
