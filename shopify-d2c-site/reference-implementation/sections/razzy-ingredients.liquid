{% comment %}
  Section contract.
  Ingredient spotlight for a product: one tilting card per key ingredient (razzy.ingredients
  metafield, e.g. "L-Theanine 50mg" shows 50mg large over the name), plus the full
  ingredients line parsed from the Supliful description.
  @example
  <!-- On the product template it uses the page's product; elsewhere pick one in settings -->
{% endcomment %}
{%- liquid
  assign rz_product = section.settings.product | default: product
  assign rz_ingredients = rz_product.metafields.razzy.ingredients.value
-%}
{%- capture rz_full -%}{% render 'razzy-description', product: rz_product, part: 'ingredients' %}{%- endcapture -%}

{%- if rz_product -%}
  <section class="rz-ingredients" style="{% render 'razzy-vars', product: rz_product %} --rz-ing-bg: {{ section.settings.background }}; --rz-ing-fg: {{ section.settings.text_color }};">
    <div class="rz-ingredients__head">
      <h2 class="rz-h2" data-rz-split>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="rz-lead" data-rz-reveal>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if rz_ingredients != blank -%}
      <ul class="rz-ingredients__grid">
        {%- for ingredient in rz_ingredients -%}
          {%- liquid
            # Split "Lion's Mane 30mg" into a name and an amount. The amount is the last word when it
            # has a digit ("Vitamin B6 6mg" -> 6mg), or the last two when the unit stands alone
            # ("Bacillus coagulans 10B CFU" -> 10B CFU).
            assign rz_words = ingredient | split: ' '
            assign rz_count = rz_words.size
            assign rz_last = rz_words | last
            assign rz_last_digits = rz_last | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
            assign rz_take = 0
            if rz_last_digits.size != rz_last.size
              assign rz_take = 1
            elsif rz_count > 2
              assign rz_index = rz_count | minus: 2
              assign rz_prev = rz_words[rz_index]
              assign rz_prev_digits = rz_prev | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
              if rz_prev_digits.size != rz_prev.size
                assign rz_take = 2
              endif
            endif
            assign rz_name_count = rz_count | minus: rz_take
            assign rz_name = rz_words | slice: 0, rz_name_count | join: ' '
            assign rz_amount = rz_words | slice: rz_name_count, rz_take | join: ' '
            if rz_take == 0
              assign rz_amount = ''
            endif
          -%}
          <li class="rz-ing{% if rz_amount == blank %} rz-ing--plain{% endif %}" data-rz-tilt="9" data-rz-reveal>
            {%- if rz_amount != blank -%}
              <span class="rz-ing__amount">{{ rz_amount | escape }}</span>
            {%- else -%}
              <svg class="rz-ing__star" viewBox="0 0 40 40" aria-hidden="true"><path fill="currentColor" d="M20 0l4.6 13.2L38 9.4l-9.8 10.6L38 30.6l-13.4-3.8L20 40l-4.6-13.2L2 30.6l9.8-10.6L2 9.4l13.4 3.8z"/></svg>
            {%- endif -%}
            <span class="rz-ing__name">{{ rz_name | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if rz_full != blank -%}
      <p class="rz-ingredients__full" data-rz-reveal>
        <strong>{{ section.settings.full_label | escape }}</strong>
        {{ rz_full }}
      </p>
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .rz-ingredients {
    display: grid;
    gap: clamp(32px, 4vw, 60px);
    padding: clamp(90px, 10vw, 150px) var(--rz-gutter);
    background: var(--rz-ing-bg);
    color: var(--rz-ing-fg);
  }

  .rz-ingredients__head {
    display: grid;
    gap: 20px;
    max-width: 960px;
  }

  .rz-ingredients__head .rz-lead {
    max-width: 44ch;
  }

  .rz-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: clamp(12px, 1.6vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rz-ing {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 36px;
    min-height: clamp(220px, 20vw, 300px);
    padding: clamp(22px, 2.2vw, 32px);
    border-radius: var(--rz-radius);
    background: var(--rz-c);
    color: var(--rz-fg);
    overflow: hidden;
    transform-style: preserve-3d;
  }

  .rz-ing::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--rz-glare-x, 30%) var(--rz-glare-y, 0%), rgb(255 255 255 / 0.22), transparent 55%);
    pointer-events: none;
  }

  .rz-ing__amount {
    font-family: var(--rz-display);
    font-weight: 900;
    font-size: clamp(54px, 5.4vw, 92px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--rz-accent);
    overflow-wrap: anywhere;
  }

  .rz-ing__star {
    width: clamp(40px, 4vw, 60px);
    height: auto;
    color: var(--rz-accent);
    animation: rz-spin 10s linear infinite;
  }

  .rz-ing__name {
    font-family: var(--rz-display);
    font-weight: 800;
    font-size: clamp(22px, 1.9vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .rz-ingredients__full {
    max-width: 90ch;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.8;
  }

  @media (max-width: 599px) {
    .rz-ingredients__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rz-ing {
      min-height: 150px;
      gap: 18px;
      padding: 18px;
    }

    .rz-ing__amount {
      font-size: clamp(34px, 10vw, 46px);
    }

    .rz-ing__name {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rz-ing__star {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Razzy ingredients",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty on product pages to use the page's product."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What's in <em>every strip.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A short list of ingredients that do the work, on a strip that melts in your mouth."
    },
    {
      "type": "text",
      "id": "full_label",
      "label": "Full ingredients label",
      "default": "Full ingredients:"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAFAF5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#05060B"
    }
  ],
  "presets": [
    {
      "name": "Razzy ingredients"
    }
  ]
}
{% endschema %}
